{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["public/index.html"],
  "boundaries": {
    "zones": [
      {
        "name": "shared",
        "patterns": ["src/shared/**"]
      },
      {
        "name": "domain",
        "patterns": ["src/types.ts", "src/state-machine.ts"]
      },
      {
        "name": "infrastructure",
        "patterns": [
          "src/proc.ts",
          "src/paths.ts",
          "src/git.ts",
          "src/pollution.ts",
          "src/settings.ts",
          "src/config.ts"
        ]
      },
      {
        "name": "subsystems",
        "patterns": [
          "src/trackers/**",
          "src/discovery/**",
          "src/inspection/**",
          "src/agents/**"
        ]
      },
      {
        "name": "orchestration",
        "patterns": [
          "src/store.ts",
          "src/pipeline.ts",
          "src/runs.ts",
          "src/understand.ts",
          "src/review.ts",
          "src/verification.ts"
        ]
      },
      {
        "name": "presentation",
        "patterns": ["src/http/**", "src/server.ts"]
      },
      {
        "name": "frontend",
        "patterns": ["public/**"]
      }
    ],
    "rules": [
      {
        "from": "shared",
        "allow": []
      },
      {
        "from": "domain",
        "allow": ["shared"]
      },
      {
        "from": "infrastructure",
        "allow": ["domain", "shared"]
      },
      {
        "from": "subsystems",
        "allow": ["domain", "infrastructure", "shared"]
      },
      {
        "from": "orchestration",
        "allow": ["domain", "infrastructure", "subsystems", "shared"]
      },
      {
        "from": "presentation",
        "allow": [
          "domain",
          "infrastructure",
          "subsystems",
          "orchestration",
          "shared"
        ]
      },
      {
        "from": "frontend",
        "allow": ["shared"]
      }
    ]
  },
  "health": {
    "ignore": ["test/**", "public/**"],
    "maxCrap": 1000.0,
    "maxCognitive": 50,
    "maxCyclomatic": 50,
    "maxUnitSize": 100
  }
}
