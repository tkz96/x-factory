{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/server.ts",
    "src/worker.ts",
    "index.html",
    "public/index.html",
    "scripts/backup.ts",
    "scripts/verify-durable-pi.ts"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "shared",
        "patterns": ["src/shared/**"]
      },
      {
        "name": "domain",
        "patterns": ["src/types.ts", "src/state-machine.ts"]
      },
      {
        "name": "infrastructure",
        "patterns": [
          "src/proc.ts",
          "src/paths.ts",
          "src/git.ts",
          "src/pollution.ts",
          "src/settings.ts",
          "src/config.ts",
          "src/diagnostics/**"
        ]
      },
      {
        "name": "data",
        "patterns": ["src/db/**"]
      },
      {
        "name": "subsystems",
        "patterns": [
          "src/trackers/**",
          "src/discovery/**",
          "src/inspection/**",
          "src/agents/**"
        ]
      },
      {
        "name": "orchestration",
        "patterns": [
          "src/store.ts",
          "src/pipeline.ts",
          "src/runs.ts",
          "src/executors/**",
          "src/understand.ts",
          "src/review.ts",
          "src/verification.ts"
        ]
      },
      {
        "name": "presentation",
        "patterns": ["src/http/**", "src/server.ts", "src/worker.ts"]
      },
      {
        "name": "frontend",
        "patterns": ["public/**", "src/frontend/**"]
      }
    ],
    "rules": [
      {
        "from": "shared",
        "allow": []
      },
      {
        "from": "domain",
        "allow": ["shared"]
      },
      {
        "from": "infrastructure",
        "allow": ["domain", "shared"]
      },
      {
        "from": "data",
        "allow": ["domain", "infrastructure", "shared"]
      },
      {
        "from": "subsystems",
        "allow": ["domain", "infrastructure", "shared"]
      },
      {
        "from": "orchestration",
        "allow": ["domain", "infrastructure", "data", "subsystems", "shared"]
      },
      {
        "from": "presentation",
        "allow": [
          "domain",
          "infrastructure",
          "data",
          "subsystems",
          "orchestration",
          "shared"
        ]
      },
      {
        "from": "frontend",
        "allow": ["shared"]
      }
    ]
  },
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["bun:sqlite"],
  "duplicates": {
    "enabled": false
  },
  "rules": {
    "unused-exports": "warn",
    "unused-types": "warn",
    "unused-files": "warn",
    "unused-class-members": "warn"
  },
  "health": {
    "ignore": ["test/**", "public/**"],
    "maxCrap": 1000.0,
    "maxCognitive": 50,
    "maxCyclomatic": 50,
    "maxUnitSize": 100
  }
}
