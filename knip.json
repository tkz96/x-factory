{
  "$schema": "https://unpkg.com/knip@5/overview/configuration.json",
  "entry": ["test/**/*.ts", "src/reticle-dev.ts"],
  "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"],
  "ignoreDependencies": ["@reticlehq/react"],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn"
  }
}
