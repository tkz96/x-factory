# X-Factory environment variables. Every one is optional.
#
# Copy this file to .env and uncomment what you need. Never commit real keys:
# .env is git-ignored, this example file is committed. Every variable here is
# read from the process environment, so an exported shell variable works too.
#
# What each one controls is described in README.md ("Configuration") and in
# docs/agents/architecture-invariants.md.

# ── Paths and storage ────────────────────────────────────────────────────────
# Root of all on-disk runtime state. Default: ~/.x-factory
#X_FACTORY_DATA_DIR=/absolute/path/to/data-dir

# SQLite database file. Default: <data dir>/x-factory.db
#X_FACTORY_DB_PATH=/absolute/path/to/x-factory.db

# Projects configuration file. Default: ./config/projects.json
#X_FACTORY_CONFIG_PATH=/absolute/path/to/projects.json

# Directory that scripts/backup.ts writes to. Default: <data dir>/backups
#BACKUP_DIR=/absolute/path/to/backups

# ── API process ──────────────────────────────────────────────────────────────
# Network interface the API listens on. Default: 127.0.0.1 (loopback only).
#X_FACTORY_HOST=127.0.0.1

# Port the API listens on. Default: 3777
#PORT=3777

# Set to production by `bun run start:production`; do not set this by hand.
#NODE_ENV=production

# ── Coding-stage sandbox ─────────────────────────────────────────────────────
# Set to 1 to let the coding stage run without sbx when sbx is not installed.
# Prefer the Settings switch. See docs/how-to/install-and-check-sbx.md.
#X_FACTORY_ALLOW_UNSANDBOXED=1

# ── Model connection keys ────────────────────────────────────────────────────
# A key set here overrides the key stored for the matching connection in
# Settings › Models. Add and check connections in the app first.
#GEMINI_API_KEY=
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=

# ── Legacy import (first launch only) ────────────────────────────────────────
# On first launch an existing LLM_API_KEY becomes a model connection, once.
# LLM_PROVIDER names its provider (anthropic, gemini or openai) when the key's
# prefix does not. Both are ignored after the import has run.
#LLM_API_KEY=
#LLM_PROVIDER=
