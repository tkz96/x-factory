{
  "name": "x-factory",
  "version": "0.1.0",
  "type": "module",
  "description": "Software engineering workbench: ticket → Pi → implementation → tests → PR",
  "scripts": {
    "start": "bun src/server.ts",
    "worker": "bun src/worker.ts",
    "start:production": "NODE_ENV=production bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "dev:frontend": "vite",
    "build": "vite build && bun run build:assets",
    "build:frontend": "vite build",
    "build:assets": "mkdir -p dist/public && cp public/docs.html public/reference.html public/styles.css public/favicon.svg dist/public/ && cp -r public/fonts public/assets dist/public/",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "test:integration": "bun --config=bunfig.selective.toml test test/integration.test.ts",
    "test:integration:production": "NODE_ENV=production bun --config=bunfig.selective.toml test test/integration.test.ts",
    "test:frontend-smoke": "bun --config=bunfig.selective.toml test test/frontend-smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:frontend": "tsc --project tsconfig.frontend.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "check:knip": "knip",
    "check:fallow": "bunx fallow",
    "check:cycles": "dpdm --exit-code circular:1 --circular --warning=false --tree=false src/server.ts public/app.ts",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@tanstack/react-query": "^5.103.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dpdm": "^4.3.0",
    "knip": "^6.36.0",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "private": true
}
